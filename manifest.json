{
  "manifest_version": 3,
  "name": "My App Launcher",
  "version": "1.0.0",
  "description": "Dashboard pribadi untuk membuka dan mengatur aplikasi web favorit.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Buka My App Launcher"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}